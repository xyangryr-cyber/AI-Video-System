{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-video-system/schemas/verification_record.schema.json",
  "title": "VerificationRecord",
  "description": "SPEC-A-100 / SPEC-0A.8: one verification attempt against a Claim. Mirrors src/shared/schemas/claim.py::VerificationRecord and src/shared/types/claim.ts::VerificationRecord.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_id",
    "claim_id",
    "verifier_type",
    "evidence_refs",
    "checked_at",
    "verdict"
  ],
  "properties": {
    "verification_id": { "type": "string", "minLength": 1 },
    "claim_id": {
      "type": "string",
      "pattern": "^(?:claim_[A-Za-z0-9_]+|dp_[A-Za-z0-9_-]+)$"
    },
    "verifier_type": {
      "type": "string",
      "enum": [
        "fact_check_agent",
        "financial_data_service",
        "web_search",
        "user_override"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string" },
          "doc_path": { "type": "string" },
          "snippet": { "type": "string" }
        }
      }
    },
    "checked_at": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string" },
    "verdict": {
      "type": "string",
      "enum": ["verified", "failed", "inconclusive"]
    },
    "reason": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
