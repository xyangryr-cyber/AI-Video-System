{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-video-system.local/schemas/chart_material.schema.json",
  "title": "ChartMaterial",
  "description": "P7A chart material: 'fetched data + generated axis' contract that exits P7A and enters P8 template rendering. Derived 1:1 from a v3.16 ChartRequest (chart_id <-> request_id) — this schema is the downstream companion of ChartRequest, never a redefinition of it. Authority: SPEC_REVISION_REQ_v3.17 A-AUDP7A-4. The cross-field invariants (y_axis.min < max, chart_spec.kind <-> x_axis.type consistency) live in src/shared/schemas/chart_material.py because JSON Schema cannot express them.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "chart_id",
    "shot_id",
    "metric_name",
    "date_range",
    "granularity",
    "source",
    "verification_status",
    "chart_spec",
    "axis_spec"
  ],
  "properties": {
    "chart_id": {"type": "string", "pattern": "^chart_\\d{3,}$"},
    "shot_id": {"type": "string", "pattern": "^shot_\\d{2,}$"},
    "metric_name": {"type": "string", "minLength": 1},
    "date_range": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      }
    },
    "granularity": {"enum": ["day", "week", "month"]},
    "source": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["provider", "symbol"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1}
      }
    },
    "verification_status": {
      "const": "verified",
      "description": "ChartMaterial is the P7A exit contract; by construction it is only emitted once the underlying ChartRequest reached the verified terminal state. Any status other than 'verified' MUST be represented as a ChartRequest (upstream) rather than a ChartMaterial."
    },
    "chart_spec": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["kind", "series"],
      "properties": {
        "kind": {"enum": ["line", "bar", "pie"]},
        "series": {"type": "array", "minItems": 1}
      }
    },
    "axis_spec": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["x_axis", "y_axis"],
      "properties": {
        "x_axis": {
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["type", "labels", "range"],
          "properties": {
            "type": {"enum": ["time", "category", "value"]},
            "labels": {"type": "array"},
            "range": {"type": "array", "minItems": 2, "maxItems": 2}
          }
        },
        "y_axis": {
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["unit", "min", "max", "scale_mode"],
          "properties": {
            "unit": {"type": "string"},
            "min": {"type": "number"},
            "max": {"type": "number"},
            "scale_mode": {"enum": ["linear", "log"]}
          }
        }
      }
    }
  }
}
