# [SPEC-B-001] Environment template. Copy to .env and fill in values.
# .env is gitignored (see .gitignore) and chmod 600 by scripts/init-data-dirs.sh.
#
# LLM providers (at least one required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LITELLM_API_KEY=

# TTS providers (Phase 4 audio)
AZURE_TTS_API_KEY=
ELEVENLABS_API_KEY=

# ByteDance OpenSpeech TTS (https://openspeech.bytedance.com/api/v1/tts)
BYTEDANCE_TTS_API_URL=
BYTEDANCE_TTS_APP_ID=
BYTEDANCE_TTS_ACCESS_TOKEN=
BYTEDANCE_TTS_SECRET_KEY=

# Eval tooling
DEEPEVAL_API_KEY=

# App config
APP_ENV=development
LOG_LEVEL=INFO

# Database
# DATABASE_URL is the canonical variable (used by docker-compose).
# DB_URL is an alias for local/legacy compatibility; if unset, code falls back to DATABASE_URL.
DATABASE_URL=sqlite:///data/db/app.sqlite3
DB_URL=sqlite:///data/db/app.sqlite3

# CORS (backend)
# Comma-separated origins that the FastAPI server will allow.
# Docker: set to "http://web:3000" (service name) or your actual host.
CORS_ORIGINS=http://localhost:3000

# Vite proxy target (frontend)
# Where the Vite dev server proxies /api and /ws requests.
# Docker: use "http://api:8000" (service name).
# Local dev (no Docker): use "http://localhost:8000" (default).
VITE_API_TARGET=http://localhost:8000
